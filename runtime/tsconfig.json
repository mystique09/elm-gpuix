  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "declaration": true,
    "outDir": "../dist",
    "rootDir": "./src"
  },
  "include": ["src"]
}
